# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo el ejemplo: es la unica documentacion viva de las 11 variables.
# Sin esta excepcion, `git add .env.example` se rechaza en silencio si alguien
# lo borra y lo vuelve a crear (hoy sobrevive por un add forzado).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Notas locales de migración (contienen datos sensibles del sistema viejo)
notas-migracion/

# Permission allowlist de la sesión Claude (config local, no del proyecto)
.claude/settings.json
.claude/settings.local.json

# Artefacto temporal: el swagger de PostgREST que se baja para inspeccionar el
# schema (`.spec.tmp.json`, ~100 KB). Se regenera con un curl, no es fuente.
*.tmp.json

# Copia local de skills de terceros que instala `npx skills add`. Duplica lo
# que ya vive versionado en .claude/skills/, y son 170 archivos de librería que
# no son código de este proyecto.
/.agents/

# Bytecode de Python (las skills traen algún script .py)
__pycache__/
*.py[cod]

# Artefacto de prueba: scripts/verificar-escritos.ts:244 escribe este PDF en la
# raiz del repo cada vez que se corre con --con-escrito.
escrito-prueba.pdf
